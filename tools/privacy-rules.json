{
  "version": 1,
  "description": "开源前隐私与凭据扫描的【通用】规则集。本文件不得写入任何本机字面量（真实用户名/邮箱/家目录/盘符布局）：那些值放 tools/privacy-local-rules.json，该文件已被 .gitignore 排除。",
  "placeholders": {
    "{{USERNAME}}": "运行扫描的机器的登录用户名（运行时替换并做正则转义）"
  },
  "skipDirNames": [
    ".git",
    "node_modules",
    ".pnpm-store",
    ".tmpdir",
    ".dsh-acl-report",
    "acl-recovery",
    ".vscode",
    ".idea"
  ],
  "skipFileNames": [
    "privacy-local-rules.json"
  ],
  "skipExtensions": [
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".ico", ".pdf",
    ".zip", ".7z", ".gz", ".tar", ".rar",
    ".exe", ".dll", ".node", ".so", ".dylib",
    ".woff", ".woff2", ".ttf", ".otf", ".eot",
    ".zstd", ".bin", ".mp3", ".mp4", ".mov", ".wav"
  ],
  "removedPaths": [
    "demo/_自测",
    "demo/_自测-复测",
    "demo/_验收",
    "notepad-app"
  ],
  "rules": [
    {
      "id": "private-key",
      "label": "私钥 / 证书块",
      "severity": "block",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "replacement": "<PRIVATE_KEY_REDACTED>",
      "why": "私钥一旦入库等同泄露，必须整块删除后重新签发。"
    },
    {
      "id": "openai-style-key",
      "label": "sk- 前缀 API key",
      "severity": "block",
      "pattern": "\\bsk-[A-Za-z0-9_-]{16,}\\b",
      "replacement": "<API_KEY_REDACTED>",
      "why": "OpenAI/DeepSeek 等厂商的密钥前缀。"
    },
    {
      "id": "github-token",
      "label": "GitHub token",
      "severity": "block",
      "pattern": "\\b(gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,})\\b",
      "replacement": "<GITHUB_TOKEN_REDACTED>",
      "why": "PAT / OAuth token 可直接推送代码。"
    },
    {
      "id": "aws-key",
      "label": "AWS Access Key ID",
      "severity": "block",
      "pattern": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b",
      "replacement": "<AWS_KEY_REDACTED>",
      "why": "云账号凭据。"
    },
    {
      "id": "google-key",
      "label": "Google API key",
      "severity": "block",
      "pattern": "\\bAIza[0-9A-Za-z_-]{30,}",
      "replacement": "<GOOGLE_KEY_REDACTED>",
      "why": "云账号凭据。"
    },
    {
      "id": "slack-token",
      "label": "Slack token",
      "severity": "block",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
      "replacement": "<SLACK_TOKEN_REDACTED>",
      "why": "团队协作凭据。"
    },
    {
      "id": "jwt",
      "label": "JWT / Bearer token",
      "severity": "block",
      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
      "replacement": "<JWT_REDACTED>",
      "why": "会话凭据，可能仍在有效期内。"
    },
    {
      "id": "secret-assignment",
      "label": "疑似密钥赋值（key = \"…\"）",
      "severity": "block",
      "pattern": "(?i)\\b(api[_-]?key|apikey|client[_-]?secret|secret[_-]?key|access[_-]?token|auth[_-]?token|refresh[_-]?token|passwd|password)\\b\\s*[:=]\\s*[\"'][^\"'\\s]{8,}[\"']",
      "replacement": null,
      "why": "无法自动判断是真是假，必须人工确认后手工脱敏（占位符改 <...>，真实值改读环境变量）。"
    },
    {
      "id": "email",
      "label": "邮箱地址",
      "severity": "block",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "allow": [
        "example.com",
        "example.org",
        "users.noreply.github.com",
        "noreply"
      ],
      "replacement": "<EMAIL_REDACTED>",
      "why": "真实邮箱是最常被反查的个人信息，也会永久留在 commit 元数据里。"
    },
    {
      "id": "windows-user-path",
      "label": "Windows 用户目录绝对路径",
      "severity": "block",
      "pattern": "(?i)[a-z]:[\\\\/]users[\\\\/][^\\\\/\\s\"'`|,;)]+",
      "replacement": "%USERPROFILE%",
      "why": "路径里嵌着登录用户名，等同实名。"
    },
    {
      "id": "windows-sid",
      "label": "Windows 用户 SID",
      "severity": "block",
      "pattern": "S-1-5-21-\\d+-\\d+-\\d+-\\d+",
      "replacement": "<USER_SID>",
      "why": "SID 前 3 段是机器 SID，属机器身份标识。"
    },
    {
      "id": "os-username",
      "label": "本机登录用户名出现",
      "severity": "block",
      "pattern": "(?<![0-9A-Za-z_]){{USERNAME}}(?![0-9A-Za-z_])",
      "replacement": "<user>",
      "why": "用户名散落在正文与日志里，路径规则覆盖不到。"
    },
    {
      "id": "posix-home-path",
      "label": "POSIX 家目录绝对路径",
      "severity": "warn",
      "pattern": "/(?:home|Users)/[A-Za-z0-9._-]+",
      "replacement": "$HOME",
      "why": "macOS/Linux 下的同款问题；命中需人工确认是否为本机路径。"
    },
    {
      "id": "outside-abs-path",
      "label": "仓库外的绝对路径（人工确认）",
      "severity": "warn",
      "pattern": "(?i)\\b[a-z]:[\\\\/](?![\\\\/])(?!(?:users|windows|program files|program files \\(x86\\)|programdata|temp|perflogs)[\\\\/])[^\\\\/\\s\"'`|,;)]+[\\\\/][^\\\\/\\s\"'`|,;)]+",
      "replacement": null,
      "why": "泄露本机盘符布局；对外文档应改成相对路径或占位符，内部记录可保留但需人工判断。"
    }
  ]
}
